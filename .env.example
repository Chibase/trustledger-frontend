# Local / demo defaults only — do NOT set NEXT_PUBLIC_DEV_ROLE in Vercel Production
# (it bypasses cookie auth and treats visitors as signed-in).

# NEXT_PUBLIC_DEV_ROLE=client

# Frappe Cloud site (Desk + API) — sole backend host (Interserv retired)
NEXT_PUBLIC_API_BASE_URL=https://app.trustledger.co.za
# Optional override for server-only BFF (defaults to NEXT_PUBLIC_API_BASE_URL)
FRAPPE_BASE_URL=https://app.trustledger.co.za

# Lead capture: Frappe CRM "CRM Lead" (preferred) — API key needs create on CRM Lead
# FRAPPE_API_KEY=
# FRAPPE_API_SECRET=
# LEAD_BACKEND=auto
# FRAPPE_LEAD_DOCTYPE=CRM Lead
# Optional instead of Resource API:
# FRAPPE_LEAD_METHOD=srm_core.api.leads.create_lead

# Public site URL (sitemap, robots, HubSpot pageUri)
NEXT_PUBLIC_SITE_URL=https://trustledger-frontend-pi.vercel.app

# demo (default) | live — live uses /api/frappe BFF + /login/live
NEXT_PUBLIC_DATA_MODE=demo

# Keep true until you want live AI methods via BFF
NEXT_PUBLIC_AI_MOCK=true

# --- Required for production lead capture (assessment + demo gate) ---
# HUBSPOT_PORTAL_ID=146786910
# HUBSPOT_FORM_ID=38d24929-09be-4c22-8a7c-ba625a61b902
# HUBSPOT_REGION=eu1

# --- Platform Operator (sole live control until you lift it) ---
# PLATFORM_OPERATOR_ONLY=0
# PLATFORM_OPERATOR_EMAILS=admin@chibaseconsulting.co.za
# Optional: also block demo /app entry (assessment stays public)
# PLATFORM_OPERATOR_LOCK_PUBLIC=0

# T5 — operator-only Customer/Owner provision tools (default off)
# FRAPPE_OWNER_ISSUANCE=0

# Optional generic webhook (used only when HubSpot env is unset)
# ASSESSMENT_WEBHOOK_URL=https://hooks.example.com/leads

# --- Paystack (Vercel checkout — ADR-019) ---
# PAYSTACK_SECRET_KEY=sk_test_…
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_…
# Amounts in ZAR cents — defaults in code are R5,399 / R14,999
# PAYSTACK_AMOUNT_SOLO_CENTS=199900
# PAYSTACK_AMOUNT_PRACTITIONER_CENTS=539900
# PAYSTACK_AMOUNT_PROJECT_CENTS=1499900
# PAYSTACK_AMOUNT_INSTITUTIONAL_CENTS=0

# Chibase Consulting packages (separate catalogue — ADR-048). ZAR cents; defaults are listed starters.
# Do not reuse PAYSTACK_AMOUNT_* for these. Paying a package must not provision TrustLedger.
# Set to 0 to keep a package request-only.
# CHIBASE_AMOUNT_FACILITATION_CENTS=9500000
# CHIBASE_AMOUNT_MEL_CENTS=12500000
# CHIBASE_AMOUNT_IKS_CENTS=11000000
# CHIBASE_AMOUNT_FIELD_CENTS=18500000

# Optional Slack/Discord/Make webhook for quote + payment pings (ADR-020)
# OPS_ALERT_WEBHOOK_URL=https://hooks.example.com/trustledger-ops


# --- Access email verification (live OTP + trial activate link) ---
# Production auto-enables when RESEND_API_KEY is set. Force on/off:
# ACCESS_EMAIL_VERIFICATION=1
# RESEND_API_KEY=re_…          # secret value (not the dashboard key *name*)
# Production From must be on a verified Resend domain (see docs/RESEND_PRODUCTION.md):
# RESEND_FROM_EMAIL=TrustLedger <noreply@trustledger.co.za>
# Do not leave Production on onboarding@resend.dev — invitees will not receive mail.

# --- Form spam protection (required for public launch traffic) ---
# Google reCAPTCHA v3 — add each public hostname in the reCAPTCHA admin console:
# product host, trustledger.co.za, chibaseconsulting.co.za, localhost
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5
# FORM_REQUIRE_RECAPTCHA=1

# --- Dual-site: Chibase Consulting brochure (same app; MX stays on Webway) ---
# After website DNS cutover (WP retired — do not import content/plugins):
# NEXT_PUBLIC_CHIBASE_SITE_URL=https://chibaseconsulting.co.za
# CHIBASE_HOSTS=chibaseconsulting.co.za,www.chibaseconsulting.co.za
# Preview /firm is noindex unless:
# NEXT_PUBLIC_CHIBASE_INDEX_PREVIEW=0

# --- Public-site security signals (optional) ---
# SECURITY_INGEST_SECRET=        # or reuse CRON_SECRET for POST /api/security/ingest
# SECURITY_ALERT_WEBHOOK_URL=    # external chat/ops webhook; at most one alert/minute

# --- Autonomous marketing engine (MKT-1 / ADR-052) — server-only; never NEXT_PUBLIC_ ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ZERNIO_API_KEY=                 # paste sk_ or zrk_ only (no Bearer, no quotes); shown once in Zernio Settings → API Keys
# ZERNIO_BASE_URL=https://zernio.com/api/v1
# ZERNIO_LINKEDIN_ACCOUNT_ID=
# ZERNIO_TWITTER_ACCOUNT_ID=
# ZERNIO_TRUSTLEDGER_LINKEDIN_ACCOUNT_ID=
# ZERNIO_CHIBASE_LINKEDIN_ACCOUNT_ID=
# Optional extra platforms as platform:accountId,platform:accountId
# ZERNIO_PLATFORMS=
# CLICKUP_API_KEY=
# CLICKUP_TEAM_ID=90121198081
# CLICKUP_LIST_ID=901220539195
# CLICKUP_WEBHOOK_SECRET=          # optional; HMAC falls back to CRON_SECRET
# CRON_SECRET=                     # also authorizes marketing crons (Vercel injects Bearer)

